---
import '../styles/global.css';
import CookieBanner from '../components/blocks/CookieBanner.astro';
import { COOKIE_CONSENT_KEY } from '../lib/cookie-consent';

const gaId = import.meta.env.PUBLIC_GA_ID;

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
}

const {
  title = 'PUEDES SER MÁS — Transformación Personal y Profesional',
  description = 'Diplomados de Coaching para la Superación Personal y Comunicación y Oratoria. Transformá tu vida: solicitá tu entrevista de admisión hoy.',
  ogImage = '/assets/logo.png',
  canonical = Astro.site?.toString() ?? 'https://puedessermas.com',
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://puedessermas.com';
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;
const canonicalUrl = canonical.startsWith('http') ? canonical : `${siteUrl}${canonical}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="PUEDES SER MÁS" />
    <meta property="og:locale" content="es_AR" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/assets/isotype.png" />

    <!-- Google Fonts (CDN - self-hosting planned for Phase 2) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Montserrat:wght@400;600;700;800&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Montserrat:wght@400;600;700;800&display=swap"
    />

    <!-- Material Symbols -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
    />

    <!-- GA4: NO se carga hasta que el usuario acepta cookies analíticas.
         El script solo define el cargador; quien lo dispara es CookieBanner. -->
    <script is:inline define:vars={{ gaId, consentKey: COOKIE_CONSENT_KEY }}>
      window.__psmLoadAnalytics = function () {
        if (window.__psmAnalyticsLoaded || !gaId) return;
        window.__psmAnalyticsLoaded = true;

        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
        document.head.appendChild(s);

        window.dataLayer = window.dataLayer || [];
        window.gtag = function () {
          window.dataLayer.push(arguments);
        };
        window.gtag('js', new Date());
        window.gtag('config', gaId, { anonymize_ip: true });
      };

      try {
        if (localStorage.getItem(consentKey) === 'accepted') window.__psmLoadAnalytics();
      } catch {
        /* localStorage bloqueado: sin consentimiento verificable, no cargamos nada. */
      }
    </script>
  </head>
  <body class="bg-bg text-text font-body">
    <slot />
    <CookieBanner />
  </body>
</html>
