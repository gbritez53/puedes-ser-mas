---
import BaseLayout from '../layouts/BaseLayout.astro';
import NavigationBlock from '../components/blocks/NavigationBlock.astro';
import DiagnosticoForm from '../components/multiple-steps/diagnostico';
import { Toaster } from 'sonner';
---

<BaseLayout
  title="Diagnóstico de Claridad — PUEDES SER MÁS"
  description="Descubrí en 7 preguntas qué es lo que realmente te está frenando y cuál es el punto de partida de tu transformación."
  ogImage="/assets/og-diagnostico.jpg"
  canonical="/diagnostico"
>
  <div class="flex h-dvh flex-col overflow-hidden bg-bg">
    <NavigationBlock minimal />
    <main class="flex flex-1 overflow-y-auto px-4 py-3 md:px-10">
      <DiagnosticoForm client:load />
    </main>
  </div>

  <Toaster
    position="top-center"
    toastOptions={{
      style: {
        background: '#121212',
        color: '#ffffff',
        border: '1px solid rgba(196, 23, 24, 0.4)',
      },
    }}
    client:load
  />
</BaseLayout>
