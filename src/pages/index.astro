---
import BaseLayout from '../layouts/BaseLayout.astro';
import NavigationBlock from '../components/blocks/NavigationBlock.astro';
import HeroBlock from '../components/blocks/HeroBlock.astro';
import DiplomadosGrid from '../components/blocks/DiplomadosGrid.astro';
import AdmissionBlock from '../components/blocks/AdmissionBlock.astro';
import FooterBlock from '../components/blocks/FooterBlock.astro';
---

<BaseLayout
  title="PUEDES SER MÁS — Diplomados de Transformación Personal y Profesional"
  description="Diplomados en Coaching y Liderazgo y en Comunicación y Oratoria. Transformá tu vida: registrate hoy."
  ogImage="/assets/logo.png"
>
  <NavigationBlock />

  <main>
    <HeroBlock />

    <DiplomadosGrid />

    <AdmissionBlock />
  </main>

  <FooterBlock />
</BaseLayout>
