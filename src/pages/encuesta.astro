---
import BaseLayout from '../layouts/BaseLayout.astro';
import NavigationBlock from '../components/blocks/NavigationBlock.astro';
import FooterBlock from '../components/blocks/FooterBlock.astro';
import EncuestaForm from '../components/multiple-steps/encuesta';
import { Toaster } from 'sonner';
---

<BaseLayout
  title="Encuesta de Diagnóstico — PUEDES SER MÁS"
  description="Descubrí cuál es tu saboteador principal y el punto de partida de tu transformación. Respondé esta encuesta de 6 pasos."
  ogImage="/assets/logo.png"
>
  <NavigationBlock />

  <main class="min-h-screen bg-bg">
    <section class="px-4 md:px-20 pt-16 md:pt-24 pb-20 max-w-[1280px] mx-auto">
      <div class="text-center mb-12">
        <p class="font-body text-sm uppercase tracking-[0.3em] text-cta mb-4">
          Diagnóstico personal
        </p>
        <h1 class="font-heading text-hero uppercase text-white">
          ¿Cuál es tu <span class="text-cta">saboteador</span>?
        </h1>
        <p class="font-body text-text-muted text-lg max-w-2xl mx-auto mt-4">
          Nada cambia en la zona cómoda. Identificá el freno que te domina y empezá a construir tu
          transformación.
        </p>
      </div>

      <EncuestaForm client:load />

      <div class="text-center mt-10">
        <p class="font-body text-text-variant text-sm max-w-md mx-auto">
          Completá los 6 pasos. Tu respuesta es confidencial y solo se usa para acompañarte mejor en
          tu proceso.
        </p>
      </div>
    </section>
  </main>

  <Toaster
    position="top-center"
    toastOptions={{
      style: {
        background: '#121212',
        color: '#ffffff',
        border: '1px solid rgba(196, 23, 24, 0.4)',
      },
    }}
    client:load
  />

  <FooterBlock />
</BaseLayout>
