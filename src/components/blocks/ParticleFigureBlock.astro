---
import ParticleFigure from '../effects/ParticleFigure';
---

<section
  class="relative h-[50vh] w-full overflow-hidden bg-black"
  aria-label="PUEDES SER MÁS — marca en partículas"
>
  <!-- Texto estático de respaldo: visible siempre (sin JS, hidratación lenta o fallo WebGL) -->
  <div class="absolute inset-0 z-0 flex items-center justify-center px-6">
    <span class="font-heading text-center text-7xl tracking-wider text-white sm:text-5xl">
      PUEDES SER MÁS
    </span>
  </div>

  <!-- El island se monta encima y lo cubre con las partículas cuando hidrata -->
  <div class="absolute inset-0 z-10">
    <ParticleFigure client:only="react" />
  </div>
</section>
