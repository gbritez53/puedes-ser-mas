---
const logoUrl = '/assets/isotype.png';

const links = [
  { href: '#filosofia', label: 'Filosofía' },
  { href: '#diplomados', label: 'Diplomados' },
  { href: '#admision', label: 'Admisión' },
  { href: '#inversion', label: 'Inversión' },
];
---

<nav class="sticky top-0 z-50 bg-black border-b border-line/30" aria-label="Navegación principal">
  <div class="flex justify-between items-center w-full px-4 md:px-20 py-4 max-w-[1280px] mx-auto">
    <div class="flex items-center gap-4">
      <a href="/" aria-label="PUEDES SER MÁS — Inicio">
        <img src={logoUrl} alt="PUEDES SER MÁS Logo" class="h-24 w-auto" loading="eager" />
      </a>
    </div>

    <div class="hidden md:flex gap-8 items-center">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="text-white font-label-bold text-[14px] leading-[20px] tracking-[0.1em] font-bold uppercase hover:text-cta transition-colors duration-200"
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <a
      href="#admision"
      class="btn-lift font-label-bold text-[14px] leading-[20px] tracking-[0.1em] font-bold uppercase px-6 py-3 rounded-lg bg-cta text-white hover:bg-cta-hover transition-colors"
    >
      POSTULAR AHORA
    </a>
  </div>
</nav>
