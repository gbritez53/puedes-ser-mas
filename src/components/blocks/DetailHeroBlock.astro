---
import type { DiplomadoDetail } from '../../content/diplomado';
import Button from '../ui/Button.astro';
import Countdown from '../ui/Countdown.astro';

interface Props {
  diplomado: DiplomadoDetail;
}

const { diplomado } = Astro.props;
---

<section
  class="relative min-h-[80vh] flex items-center pt-20 pb-16 px-4 md:px-20 overflow-hidden"
  aria-label={`Diplomado en ${diplomado.headlineAccent}`}
>
  <!-- Fondo: la imagen vertical solo se usa a sangre en mobile, atenuada -->
  <div class="absolute inset-0 z-0 md:hidden" aria-hidden="true">
    <img
      src={diplomado.heroImageUrl}
      alt=""
      class="absolute inset-0 w-full h-full object-cover object-top opacity-25"
      loading="eager"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black via-black/85 to-black/60"></div>
  </div>

  <div
    class="relative z-10 w-full max-w-[1280px] mx-auto grid grid-cols-1 md:grid-cols-12 gap-10 items-center"
  >
    <div class="md:col-span-7 flex flex-col items-start gap-6">
      <div class="flex gap-2 mb-2">
        {
          diplomado.chips.map((chip) => (
            <span class="inline-block bg-black border border-accent text-accent-soft font-body text-xs px-3 py-1 rounded-sm uppercase tracking-wider font-bold">
              {chip}
            </span>
          ))
        }
      </div>

      <h1 class="font-heading text-[clamp(3rem,7vw,4.5rem)] leading-none uppercase text-white">
        {diplomado.headline}
        <br />
        <span class="text-gradient-cta">{diplomado.headlineAccent}</span>
      </h1>

      <p class="font-body text-text-variant text-[18px] leading-7 max-w-2xl">
        {diplomado.heroDescription}
      </p>

      <Countdown
        target={diplomado.inscripcionDeadline}
        label="Cierra la inscripción en"
        class="mt-2"
      />

      <div class="mt-6 flex flex-col sm:flex-row gap-4 w-full sm:w-auto">
        <Button href="/#registro">¡INSCRÍBETE AHORA!</Button>
        <Button variant="ghost" type="button">
          <span
            class="material-symbols-outlined"
            style="font-variation-settings: 'FILL' 1;"
            aria-hidden="true"
          >
            play_circle
          </span>
          VER INTRODUCCIÓN
        </Button>
      </div>
    </div>

    <!-- Columna visual: aprovecha el formato vertical de la foto -->
    <div class="hidden md:block md:col-span-5">
      <div
        class="relative aspect-[4/5] w-full max-w-[420px] ml-auto overflow-hidden rounded-lg border border-line"
      >
        <img
          src={diplomado.heroImageUrl}
          alt={diplomado.title}
          class="absolute inset-0 w-full h-full object-cover"
          loading="eager"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent">
        </div>
        <div class="absolute inset-x-0 bottom-0 h-[3px] bg-cta"></div>
      </div>
    </div>
  </div>
</section>
