---
interface Props {
  chip: string;
  title: string;
  description: string;
  enfoque: string[];
  promesa: string;
  fechaInicio: string;
  plazas: string;
  features: string[];
  cta: string;
  imageUrl: string;
  href: string;
  variant?: 'red' | 'blue';
}

const {
  chip,
  title,
  description,
  enfoque,
  promesa,
  fechaInicio,
  plazas,
  features,
  cta,
  href,
  variant = 'red',
} = Astro.props;
---

<article
  class:list={[
    'gradient-card',
    'relative',
    'rounded-xl',
    'overflow-hidden',
    'transition-all',
    'duration-300',
    variant === 'blue' ? 'gradient-card-blue' : '',
  ]}
>
  {/* Blob de gradiente animado recorriendo las esquinas */}
  <div class="gradient-blob" aria-hidden="true"></div>

  {/* Borde de luz que recorre el perímetro (roja horaria, azul antihoraria) */}
  <span class="card-beam" aria-hidden="true"></span>

  {/* Contenido glassy sobre el blob, con borde del color de la card */}
  <div
    class="glass-panel relative z-10 bg-black/65 backdrop-blur-[24px] overflow-hidden flex flex-col h-full"
  >
    <div class="p-6 flex-1 flex flex-col">
      <div
        class="inline-block bg-black border text-[10px] px-2 py-1 rounded-sm mb-4 uppercase w-fit font-bold tracking-[0.1em]"
        style="border-color: var(--card-accent); color: var(--card-accent-soft)"
      >
        {chip}
      </div>

      <h3 class="font-heading text-[28px] leading-[30px] mb-2 text-white uppercase">{title}</h3>

      <p class="font-body text-[16px] leading-[24px] text-text-variant mb-4">{description}</p>

      <div class="mb-4">
        <p
          class="font-body text-[11px] uppercase tracking-widest font-bold mb-2"
          style="color: var(--card-accent-soft)"
        >
          Enfoque
        </p>
        <div class="flex flex-wrap gap-2">
          {
            enfoque.map((item) => (
              <span
                class="font-body text-[11px] px-2 py-1 rounded-sm bg-white/5 border border-white/15 text-white"
                style="border-color: color-mix(in srgb, var(--card-accent) 40%, transparent)"
              >
                {item}
              </span>
            ))
          }
        </div>
      </div>

      <blockquote class="pl-3 mb-4" style="border-left: 2px solid var(--card-accent)">
        <p class="font-body text-[14px] leading-[22px] italic text-white">{promesa}</p>
      </blockquote>

      <ul class="space-y-2 mb-6 flex-1">
        <li class="flex items-center gap-2 font-body text-sm text-white">
          <span
            class="material-symbols-outlined text-sm"
            style="color: var(--card-accent)"
            aria-hidden="true"
          >
            event
          </span>
          {fechaInicio}
        </li>
        <li class="flex items-center gap-2 font-body text-sm text-white">
          <span
            class="material-symbols-outlined text-sm"
            style="color: var(--card-accent)"
            aria-hidden="true"
          >
            group
          </span>
          {plazas}
        </li>
        {
          features.map((feature) => (
            <li class="flex items-center gap-2 font-body text-sm text-white">
              <span
                class="material-symbols-outlined text-sm"
                style="color: var(--card-accent)"
                aria-hidden="true"
              >
                check_circle
              </span>
              {feature}
            </li>
          ))
        }
      </ul>

      <a
        href={href}
        class="btn-lift text-cta font-body text-[14px] tracking-[0.1em] font-bold uppercase text-center w-full py-3 border border-cta rounded-lg hover:bg-cta hover:text-white transition-colors"
      >
        {cta}
      </a>
    </div>
  </div>
</article>

<style>
  .gradient-card {
    --card-accent: var(--color-cta);
    --card-accent-soft: #ff8a80;
    border: 1px solid color-mix(in srgb, var(--card-accent) 35%, transparent);
    padding: 4px;
  }

  .gradient-card-blue {
    --card-accent: var(--color-accent);
    --card-accent-soft: #7ba4e8;
  }

  .gradient-card:hover {
    transform: translateY(-2px);
    border-color: var(--card-accent);
    box-shadow: 0 0 30px color-mix(in srgb, var(--card-accent) 40%, transparent);
  }

  /* Vidrio con borde del color de la card (como el outline del prompt) */
  .glass-panel {
    border-radius: 10px;
    outline: 2px solid color-mix(in srgb, var(--card-accent) 70%, transparent);
  }

  .gradient-card:hover .glass-panel {
    outline-color: var(--card-accent);
  }

  /* Blob de gradiente animado (recorre las 4 esquinas) */
  .gradient-blob {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 220px;
    height: 220px;
    border-radius: 9999px;
    filter: blur(18px);
    z-index: 0;
    animation: blob 5s linear infinite;
  }

  /* Card roja: gradiente bold rojo */
  .gradient-card .gradient-blob {
    background: linear-gradient(to right, #ec4899, #ef4444, #eab308);
  }

  /* Card azul: gradiente bold azul */
  .gradient-card-blue .gradient-blob {
    background: linear-gradient(to right, #38bdf8, #1d4ed8, #818cf8);
  }

  /* Borde de luz que recorre el perímetro: card roja horaria, azul antihoraria */
  .card-beam {
    position: absolute;
    inset: -100%;
    z-index: 0;
    pointer-events: none;
    background: conic-gradient(
      from 0deg,
      transparent 0deg,
      transparent 280deg,
      color-mix(in srgb, var(--card-accent) 45%, transparent) 325deg,
      color-mix(in srgb, var(--card-accent) 65%, white) 348deg,
      #ffffff 356deg,
      transparent 360deg
    );
    animation: border-light-spin-cw 2.5s linear infinite;
  }

  .gradient-card-blue .card-beam {
    animation: border-light-spin-ccw 2.5s linear infinite;
  }

  @keyframes blob {
    0% {
      transform: translate(-100%, -100%);
    }
    25% {
      transform: translate(0%, -100%);
    }
    50% {
      transform: translate(0%, 0%);
    }
    75% {
      transform: translate(-100%, 0%);
    }
    100% {
      transform: translate(-100%, -100%);
    }
  }

  @keyframes border-light-spin-cw {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes border-light-spin-ccw {
    to {
      transform: rotate(-360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gradient-blob,
    .card-beam {
      animation: none;
    }
  }
</style>
