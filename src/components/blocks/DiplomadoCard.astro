---
interface Props {
  chip: string;
  title: string;
  description: string;
  enfoque: string[];
  promesa: string;
  fechaInicio: string;
  plazas: string;
  features: string[];
  cta: string;
  imageUrl: string;
  href: string;
  variant?: 'red' | 'blue';
}

const {
  chip,
  title,
  description,
  enfoque,
  promesa,
  fechaInicio,
  plazas,
  features,
  cta,
  imageUrl,
  href,
  variant = 'red',
} = Astro.props;
---

<article
  class:list={[
    'border-light',
    'card-glow',
    'rounded-xl',
    'transition-all',
    'duration-300',
    variant === 'blue' ? 'border-light-blue' : '',
  ]}
>
  <span class="light-beam" aria-hidden="true"></span>

  <div class="relative z-10 bg-surface rounded-xl overflow-hidden flex flex-col h-full">
    <div class="h-48 relative">
      <img
        src={imageUrl}
        alt=""
        class="w-full h-full object-cover"
        loading="lazy"
        aria-hidden="true"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-surface to-transparent"></div>
    </div>

    <div class="p-6 flex-1 flex flex-col">
      <div
        class="inline-block bg-black border border-accent text-accent-soft font-body text-[10px] px-2 py-1 rounded-sm mb-4 uppercase w-fit font-bold tracking-[0.1em]"
      >
        {chip}
      </div>

      <h3 class="font-heading text-[28px] leading-[30px] mb-2 text-white uppercase">{title}</h3>

      <p class="font-body text-[16px] leading-[24px] text-text-variant mb-4">{description}</p>

      <div class="mb-4">
        <p class="font-body text-[11px] uppercase tracking-widest font-bold text-accent-soft mb-2">
          Enfoque
        </p>
        <div class="flex flex-wrap gap-2">
          {
            enfoque.map((item) => (
              <span class="font-body text-[11px] px-2 py-1 rounded-sm bg-accent/15 border border-accent/40 text-white">
                {item}
              </span>
            ))
          }
        </div>
      </div>

      <blockquote class="border-l-2 border-cta pl-3 mb-4">
        <p class="font-body text-[14px] leading-[22px] italic text-white">{promesa}</p>
      </blockquote>

      <ul class="space-y-2 mb-6 flex-1">
        <li class="flex items-center gap-2 font-body text-sm text-white">
          <span
            class="material-symbols-outlined text-cta text-sm"
            style="font-variation-settings: 'FILL' 1;"
            aria-hidden="true"
          >
            event
          </span>
          {fechaInicio}
        </li>
        <li class="flex items-center gap-2 font-body text-sm text-white">
          <span
            class="material-symbols-outlined text-cta text-sm"
            style="font-variation-settings: 'FILL' 1;"
            aria-hidden="true"
          >
            group
          </span>
          {plazas}
        </li>
        {
          features.map((feature) => (
            <li class="flex items-center gap-2 font-body text-sm text-white">
              <span
                class="material-symbols-outlined text-cta text-sm"
                style="font-variation-settings: 'FILL' 1;"
                aria-hidden="true"
              >
                check_circle
              </span>
              {feature}
            </li>
          ))
        }
      </ul>

      <a
        href={href}
        class="btn-lift text-cta font-body text-[14px] tracking-[0.1em] font-bold uppercase text-center w-full py-3 border border-cta rounded-lg hover:bg-cta hover:text-white transition-colors"
      >
        {cta}
      </a>
    </div>
  </div>
</article>

<style>
  .border-light {
    --card-accent: var(--color-cta);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 2px;
    border-radius: 0.75rem;
    box-shadow:
      0 0 18px color-mix(in srgb, var(--card-accent) 45%, transparent),
      0 0 45px color-mix(in srgb, var(--card-accent) 22%, transparent);
  }

  .border-light-blue {
    --card-accent: var(--color-accent);
  }

  /* Marco de color: siempre visible para que la card resalte */
  .border-light::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--card-accent) 75%, transparent),
      color-mix(in srgb, var(--card-accent) 35%, transparent)
    );
  }

  /* Haz de luz: una sola luz por card, recorre el borde a ritmo constante.
     La card roja gira en sentido horario; la azul, antihorario: ambas a la
     misma velocidad, así parten del mismo punto y se cruzan en el opuesto. */
  .light-beam {
    position: absolute;
    inset: -100%;
    z-index: 0;
    pointer-events: none;
    background: conic-gradient(
      from 0deg,
      transparent 0deg,
      transparent 280deg,
      color-mix(in srgb, var(--card-accent) 45%, transparent) 325deg,
      color-mix(in srgb, var(--card-accent) 65%, white) 348deg,
      #ffffff 356deg,
      transparent 360deg
    );
    animation: border-light-spin-cw 2.5s linear infinite;
  }

  .border-light-blue .light-beam {
    animation: border-light-spin-ccw 2.5s linear infinite;
  }

  .card-glow:hover {
    box-shadow:
      0 0 30px color-mix(in srgb, var(--card-accent) 65%, transparent),
      0 0 70px color-mix(in srgb, var(--card-accent) 30%, transparent);
    transform: translateY(-2px);
  }

  @keyframes border-light-spin-cw {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes border-light-spin-ccw {
    to {
      transform: rotate(-360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .light-beam {
      animation: none;
    }
  }
</style>
