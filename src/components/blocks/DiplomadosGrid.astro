---
import DiplomadoCard from './DiplomadoCard.astro';
import { diplomados } from '../../content/diplomados';

const cards = Object.values(diplomados);
---

<section class="py-20 px-4 md:px-20 max-w-[1280px] mx-auto" id="diplomados" aria-label="Diplomados">
  <div class="text-center mb-16">
    <h2 class="font-heading text-[48px] leading-[48px] uppercase mb-4 text-white">
      ¿CUÁL ES TU SIGUIENTE NIVEL DE <span class="text-cta">TRANSFORMACIÓN?</span>
    </h2>
    <div class="w-24 h-1 bg-cta mx-auto"></div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {
      cards.map((diplomado) => (
        <DiplomadoCard
          chip={diplomado.chip}
          title={diplomado.title}
          description={diplomado.heroDescription}
          enfoque={diplomado.enfoque}
          promesa={diplomado.promesa}
          fechaInicio={diplomado.fechaInicio}
          plazas={diplomado.plazas}
          features={[]}
          cta="VER MAPA DE TRANSFORMACIÓN"
          imageUrl={diplomado.heroImageUrl}
          href={'/diplomados/' + diplomado.slug}
        />
      ))
    }
  </div>
</section>
