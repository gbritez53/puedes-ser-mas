---
import { AdmissionForm } from '../islands/AdmissionForm';
---

<section
  class="py-20 px-4 md:px-20 bg-surface-lowest border-t border-line/50"
  id="registro"
  aria-label="Registro — Diplomados"
>
  <div class="max-w-4xl mx-auto flex flex-col md:flex-row gap-12 items-center">
    <div class="flex-1 text-center md:text-left">
      <h2 class="font-heading text-[56px] leading-[56px] uppercase mb-4 text-white">
        ¡SUPÉRATE SIEMPRE!
        <br />
        <span class="text-cta">REGÍSTRATE HOY</span>
      </h2>
      <p class="font-body text-[18px] leading-[28px] text-text-variant">
        Completa tus datos para recibir la información detallada de nuestros diplomados y comenzar
        tu transformación.
      </p>
    </div>

    <div
      class="w-full md:w-1/2 bg-surface p-8 rounded-xl border border-line/30 relative overflow-hidden"
    >
      <div
        class="absolute -top-10 -right-10 w-32 h-32 bg-cta/10 rounded-full blur-3xl"
        aria-hidden="true"
      >
      </div>
      <div class="relative z-10">
        <AdmissionForm client:visible />
      </div>
    </div>
  </div>
</section>
