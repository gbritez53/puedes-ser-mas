---
const logoUrl =
  'https://lh3.googleusercontent.com/aida-public/AB6AXuAbtU_j4-SfTTprsz0tbcXXbSzeeRp8E1bhzeufBq-cx62Ijgxj68DuxmropqVaThVGZgVwMVWmbzXYUTv7ZYvnSIKsjnHnyM8yDSEy_og7HYV4OQuEohGVR-uKDTCWsYCsfpo_KPPYwMwKKCaHkoQq4kOyphK6ZQisTM-aBl7bnsUwMlzNp1sRt1JPmT_nyJxaMHtwVl9xX0yPUNcp1xMT73oXNWGCOo2E0fX0UKgU2FOs1BV2ScZA';

const year = new Date().getFullYear();

const links = [
  { label: 'Política de Privacidad' },
  { label: 'Términos de Servicio' },
  { label: 'Cookies' },
];
---

<footer class="bg-surface-lowest border-t border-line/30" aria-label="Pie de página">
  <div
    class="flex flex-col items-center w-full px-4 md:px-20 py-20 max-w-[1280px] mx-auto text-center gap-8"
  >
    <img
      src={logoUrl}
      alt="PUEDES SER MÁS Logo"
      class="h-16 w-auto grayscale opacity-80"
      loading="lazy"
    />

    <p class="font-heading text-[28px] text-white uppercase tracking-wider max-w-2xl">
      PUEDES SER MÁS es más que una marca: <span class="text-cta">es un movimiento.</span>
    </p>

    <div class="flex flex-wrap justify-center gap-6 mt-4">
      {
        links.map((link) => (
          <a
            href="#"
            class="text-text-variant font-body text-[16px] leading-[24px] hover:text-[#ffb3ac] transition-colors duration-200"
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <p class="text-text-variant font-body text-sm mt-8 opacity-50">
      © {year} PUEDES SER MÁS. Todos los derechos reservados.
    </p>
  </div>
</footer>
