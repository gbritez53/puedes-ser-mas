---
interface Props {
  /** Fecha objetivo en ISO 8601 (con offset). Ej: '2026-09-10T23:59:00-03:00' */
  target: string;
  /** Texto que acompaña al contador */
  label?: string;
  /** Alineación del bloque */
  align?: 'start' | 'center';
  class?: string;
}

const {
  target,
  label = 'Cierre de inscripción',
  align = 'start',
  class: className = '',
} = Astro.props;

const units = [
  { key: 'days', label: 'Días' },
  { key: 'hours', label: 'Horas' },
  { key: 'minutes', label: 'Min' },
  { key: 'seconds', label: 'Seg' },
] as const;

const alignment = align === 'center' ? 'items-center' : 'items-start';
---

<div
  class:list={['flex flex-col gap-3', alignment, className]}
  data-countdown
  data-target={target}
  role="timer"
>
  {
    label && (
      <p class="font-body text-[10px] md:text-xs uppercase tracking-[0.25em] text-cta font-bold flex items-center gap-2">
        <span class="relative flex h-2 w-2" aria-hidden="true">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-cta opacity-75" />
          <span class="relative inline-flex h-2 w-2 rounded-full bg-cta" />
        </span>
        {label}
      </p>
    )
  }

  <div class="flex items-end gap-2 sm:gap-3 md:gap-4">
    {
      units.map((unit, index) => (
        <Fragment>
          {index > 0 && (
            <span class="font-heading text-2xl sm:text-3xl md:text-4xl text-white/40 mb-4 md:mb-5 leading-none">
              :
            </span>
          )}
          <div class="flex flex-col items-center">
            <div class="flex gap-[2px]">
              <div class="digit-box">
                <span class="digit" data-unit={unit.key} data-index="0">
                  0
                </span>
              </div>
              <div class="digit-box">
                <span class="digit" data-unit={unit.key} data-index="1">
                  0
                </span>
              </div>
            </div>
            <span class="font-body text-[9px] md:text-[10px] tracking-[0.2em] uppercase mt-2 font-bold text-text-variant">
              {unit.label}
            </span>
          </div>
        </Fragment>
      ))
    }
  </div>
</div>

<style>
  .digit-box {
    display: flex;
    justify-content: center;
    overflow: hidden;
    width: 1.75rem;
    border-radius: 4px;
    background: color-mix(in srgb, var(--color-surface) 70%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-line) 80%, transparent);
    padding: 0.25rem 0;
  }

  @media (min-width: 768px) {
    .digit-box {
      width: 2.5rem;
      padding: 0.375rem 0;
    }
  }

  .digit {
    display: block;
    font-family: var(--font-heading);
    font-size: 1.75rem;
    line-height: 1;
    color: var(--color-text);
  }

  @media (min-width: 768px) {
    .digit {
      font-size: 2.5rem;
    }
  }

  @keyframes cdSlideOut {
    from {
      transform: translateY(0);
      opacity: 1;
    }
    to {
      transform: translateY(80%);
      opacity: 0;
    }
  }

  @keyframes cdSlideIn {
    from {
      transform: translateY(-80%);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  .cd-out {
    animation: cdSlideOut 0.18s ease-in forwards;
  }

  .cd-in {
    animation: cdSlideIn 0.22s ease-out forwards;
  }

  @media (prefers-reduced-motion: reduce) {
    .cd-out,
    .cd-in {
      animation: none !important;
    }
  }
</style>

<script>
  const pad = (n: number) => String(n).padStart(2, '0');

  function animateDigit(el: HTMLElement, next: string) {
    if (el.textContent === next) return;
    el.classList.add('cd-out');
    window.setTimeout(() => {
      el.textContent = next;
      el.classList.remove('cd-out');
      el.classList.add('cd-in');
      window.setTimeout(() => el.classList.remove('cd-in'), 220);
    }, 180);
  }

  function initCountdown(root: HTMLElement) {
    const target = new Date(root.dataset.target ?? '').getTime();
    if (Number.isNaN(target)) return;

    const setUnit = (unit: string, value: number) => {
      const digits = pad(value);
      root
        .querySelectorAll<HTMLElement>(`[data-unit="${unit}"]`)
        .forEach((el) => animateDigit(el, digits[Number(el.dataset.index)] ?? '0'));
    };

    let intervalId = 0;

    const tick = () => {
      const diff = Math.max(0, target - Date.now());
      setUnit('days', Math.floor(diff / 86400000));
      setUnit('hours', Math.floor((diff % 86400000) / 3600000));
      setUnit('minutes', Math.floor((diff % 3600000) / 60000));
      setUnit('seconds', Math.floor((diff % 60000) / 1000));
      if (diff <= 0 && intervalId) window.clearInterval(intervalId);
    };

    tick();
    intervalId = window.setInterval(tick, 1000);
  }

  document.querySelectorAll<HTMLElement>('[data-countdown]').forEach(initCountdown);
</script>
